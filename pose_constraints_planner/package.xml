<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pose_constraints_planner</name>
  <version>0.2.0</version>
  <description>
    Joint-space path planner whose path satisfies geometric constraints on the tool pose
    (plane, line, angle). Multi-goal MI-RRT* planning pipeline of parallel_multigoal_planner,
    with rejection sampling on the constraints and constraint checks along every edge.
    Action server pose_constraints_msgs/action/PlanWithConstraints.
  </description>
  <maintainer email="manuel.beschi@unibs.it">Manuel Beschi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>pluginlib</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>moveit_msgs</depend>
  <depend>graph_core</depend>
  <depend>mirrt_star</depend>
  <depend>ik_solver</depend>
  <depend>urdfdom</depend>
  <depend>parallel_multigoal_planner</depend>
  <depend>pose_constraints_msgs</depend>

  <exec_depend>ur_ik_solver</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
