# Doxygen configuration. Generate the documentation with:
#   doxygen Doxyfile
# and open doxygen/html/index.html

PROJECT_NAME           = "pose_constraint_path_planning"
PROJECT_BRIEF          = "Joint-space path planning with geometric constraints on the tool pose"
OUTPUT_DIRECTORY       = doxygen

INPUT                  = README.md docs pose_constraints_planner/include pose_constraints_planner/src pose_constraints_planner/pose_constraints_planner
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.py *.md
EXCLUDE_PATTERNS       = */build/* */install/* */log/* */doxygen/* */.git/* */docs/API.md
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
SOURCE_BROWSER         = YES
BUILTIN_STL_SUPPORT    = YES
WARN_IF_UNDOCUMENTED   = YES
QUIET                  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
